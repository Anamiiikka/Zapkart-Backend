# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
# Either provide a single DATABASE_URL (used by Render/Neon/managed Postgres, SSL),
# or the individual DB_* vars below for local development.
# DATABASE_URL=postgresql://user:pass@host:5432/zapkart?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zapkart
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
JWT_EXPIRES_IN=1d

# CORS — comma-separated allowed origins, or '*' for any (the simulator is same-origin)
CORS_ORIGIN=*

# Rate limits (raised so the interactive simulator can fire bursts of requests)
RATE_LIMIT_MAX=5000        # global requests / 15 min / IP
ORDER_RATE_LIMIT_MAX=1000  # order placements / min / IP (default 5)
AUTH_RATE_LIMIT_MAX=200    # login attempts / 15 min / IP (default 15)

# Logging
LOG_LEVEL=info
