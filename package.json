{
  "name": "zapkart-backend",
  "version": "1.0.0",
  "description": "Zapkart e-commerce backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "node db/seed.js",
    "db:migrate": "psql -U postgres -d zapkart -f db/migrations/init.sql && psql -U postgres -d zapkart -f db/migrations/add_indexes.sql"
  },
  "keywords": [
    "ecommerce",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2"
  }
}
